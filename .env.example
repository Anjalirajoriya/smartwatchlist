# Server-only secrets. Never prefix these with VITE_.
GROQ_API_KEY=gsk_your_key_here
DATABASE_URL=postgresql://postgres:password@localhost:5432/market_memory
TWELVE_DATA_API_KEY=your_twelve_data_key_here
# Verified-news evidence adapter (free development key available at gnews.io).
GNEWS_API_KEY=your_gnews_key_here

# Pick ONE local Firebase Admin option. The path is easier for development.

FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}

# Firebase browser config. These are public identifiers.
VITE_FIREBASE_API_KEY=your_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-web-app-id
